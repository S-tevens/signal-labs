# Copy to .env.local (git-ignored). Dev values only.
# With a token set, the dashboard shows LIVE data from the SaaS; without one it shows labelled demo data.
VITE_DASHBOARD_TOKEN=dash-acme
# Optional: call the SaaS directly instead of through the dev proxy (then the SaaS must allow this origin via DASHBOARD_ORIGINS).
# VITE_SAAS_URL=http://localhost:8000
# Optional: where the dev proxy forwards /api (default http://127.0.0.1:8000).
# SAAS_PROXY_TARGET=http://127.0.0.1:8001

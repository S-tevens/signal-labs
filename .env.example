# Development values only. Never reuse these outside a local demo.
# Dev values for running the collector and SaaS natively (see the README quick start).

# --- Collector ---
COLLECTOR_ID=col-blr-01
TENANT_REF=t-acme
REGION=in
COLLECTOR_KEY=key-acme-1
COLLECTOR_SECRET=dev-secret-acme
PSEUDO_SECRET=dev-local-pseudonym-secret
SAAS_URL=http://127.0.0.1:8000
DATA_DIR=./data/collector

# --- SaaS (see saas/README.md) ---
DATABASE_URL=postgresql://signal_app:dev_app_password@localhost:5433/signal
REGION=in
REPLICA_ID=1
# Credentials map: collector key -> tenant, region, collector id, secret; dashboard token -> tenant, role.
SAAS_AUTH_JSON={"collectors":{"key-acme-1":{"tenant":"t-acme","region":"in","collector":"col-blr-01","secret":"dev-secret-acme"}},"dashboard":{"dash-acme":{"tenant":"t-acme","region":"in","role":"operator"},"dash-admin":{"tenant":"t-acme","region":"in","role":"admin"}}}
